# Django Backend Environment Variables

# Django SECRET_KEY (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=your-django-secret-key-here

# Debug mode (set to false in production)
DEBUG=true

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------
# DATABASE — Neon Postgres (Vercel)
# Get this from: Vercel Dashboard → Storage → your Neon DB → Connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
# -----------------------------------------------
DATABASE_URL=postgresql://your-user:your-password@your-neon-host/your-db?sslmode=require

# CORS settings
# Set to "false" in production and use CORS_ALLOWED_ORIGINS instead
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI service URL (for firebase_service.py → fetching user persona)
DBSERVER_URL=http://localhost:8001
