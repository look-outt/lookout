# AI Service Environment Variables

# Azure OpenAI configuration
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Google Gemini (optional fallback)
GOOGLE_API_KEY=your-google-api-key

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Local cache paths for datasets (downloaded from HF if absent)
LINKEDIN_POSTS_CSV_PATH=app/db/linkedin_multiple_posts.csv
HOOKS_CSV_PATH=app/db/hooks.csv
FRAMEWORKS_CSV_PATH=app/db/frameworks.csv
CTA_CSV_PATH=app/db/cta.csv
FAISS_INDEX_PATH=data/faiss_index

# -----------------------------------------------
# Hugging Face Datasets
# Upload your CSV files to a HF dataset repo, then set:
# HF_DATASET_REPO=your-username/lookout-datasets
# For private repos, generate a token at huggingface.co/settings/tokens
# -----------------------------------------------
HF_DATASET_REPO=your-hf-username/lookout-datasets
HF_TOKEN=

# Django dbserver URL (for fetching user persona)
DBSERVER_URL=http://localhost:8001
